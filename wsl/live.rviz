Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /TF1
        - /TF1/Tree1
      Splitter Ratio: 0.5
    Tree Height: 640
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
      Color: 70; 70; 70
      Reference Frame: <Fixed Frame>
      Value: true
    # slam_toolbox 的二維佔據地圖。Nav2 的全域規劃就是吃這張。
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Alpha: 0.75
      Color Scheme: map
      # ★ 一定要 false。true 的話 WSLg 上整個畫面會變黑。
      #
      # 地圖是 8-bit 索引影像,RViz 用 rviz/glsl120/indexed_8bit_image 這支
      # shader 上色,在 Mesa 上連結失敗:
      #   "active samplers with a different type refer to the same texture image unit"
      # Draw Behind 會把它畫成鋪滿畫面的底層,shader 壞掉時那層就是純黑,
      # 把 Grid / TF / Scan 全蓋住 —— 看起來像 RViz 沒收到任何資料。
      #
      # 關掉之後地圖照樣顯示(只是跟雷射點同層),而且不會蓋住東西。
      Draw Behind: false
      Value: true
    # 由 /cloud_registered_body 壓成的二維掃描。這是 SLAM 和 Nav2 真正看到的東西 ——
    # 點雲好看但不參與導航,有落差的話以這條為準。
    - Class: rviz_default_plugins/LaserScan
      Name: Scan
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        History Policy: Keep Last
      Size (m): 0.05
      Style: Spheres
      Color: 255; 90; 90
      Color Transformer: FlatColor
      Decay Time: 0
      Value: true
    # 世界座標系的累積點雲。zenoh bridge 已把它限流到 3 Hz。
    - Class: rviz_default_plugins/PointCloud2
      Name: Cloud
      Enabled: false
      Topic:
        Value: /cloud_registered
        Depth: 2
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        History Policy: Keep Last
      Size (m): 0.02
      Style: Points
      Color Transformer: AxisColor
      Axis: Z
      Decay Time: 0
      Value: false
    # EKF 融合後的位姿。跟 TF 的 multi_odom -> base_footprint 是同一份。
    - Class: rviz_default_plugins/Odometry
      Name: EKF Odom
      Enabled: false
      Topic:
        Value: /odometry/filtered
        Depth: 10
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
      Keep: 100
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Shape:
        Shaft Length: 0.3
        Shaft Radius: 0.03
        Head Length: 0.1
        Head Radius: 0.06
        Color: 80; 220; 140
      Value: false
    # 底盤自己發的 /robot_description，只有底盤本體沒有 box_link 以上。
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      # ★ 讀本機檔案,不靠 /robot_description。兩個理由:
      #
      # 1. /robot_description 是 latched(只發一次)。zenoh bridge 若在底盤
      #    開機之後才啟動,就永遠拿不到那筆保留訊息 —— 2026-08-11 實測收不到。
      #    /tf_static 也有同樣問題,那個靠重啟 bridge 解決了,但這個沒有。
      #
      # 2. 底盤發的那份只有車體,沒有 box_link / body / camera_link
      #    (那些是我們用 static_transform_publisher 發的,不在任何 URDF 裡)。
      #    本機這份是 gen_view_urdf.py 從 robot_tf.sh 產的,兩者都有。
      #
      # 改過 robot_tf.sh 的座標之後要重跑「更新模型.bat」才會同步。
      Description Source: File
      Description File: /home/andykuo/lidar_view/qbot_view.urdf
      Alpha: 0.85
      Visual Enabled: true
      Collision Enabled: false
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.4
      Update Interval: 0
      Frame Timeout: 15
      Value: true
  Global Options:
    Background Color: 40; 42; 46
    Fixed Frame: map
    Frame Rate: 20
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    # 手動給 Nav2 目標點。★ 現在不要真的按 —— 車會動。
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 16
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.85
      Yaw: 2.4
      Near Clip Distance: 0.01
      Target Frame: <Fixed Frame>
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Views:
    collapsed: true
  Height: 960
  Width: 1600
  Hide Left Dock: false
  Hide Right Dock: true
  QMainWindow State: ""
