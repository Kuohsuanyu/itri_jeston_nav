<?xml version="1.0" encoding="UTF-8" ?>
<!--
  WSL 端(TCP 客戶端)

  為什麼不用預設的 UDP:
    mirrored 模式下 WSL 共用 Windows 的 IP,入站封包要過 Windows 主機防火牆,
    預設拒絕未經請求的 UDP。實測 tcpdump 在 WSL 內只看得到 Out、零個 In,
    Jetson 的 DDS 回應全部被丟棄,discovery 永遠完成不了。
    改主機防火牆規則需要管理員權限。

  改用 TCP 的兩個好處:
    1. 由 WSL 主動撥出去,是「出站連線」,防火牆預設放行;
       後續雙向資料都走這條已建立的連線,不需要任何入站規則。
    2. /cloud_registered 每則 0.36 MB,UDP 要分片,WiFi 掉一片就整包報廢。
       TCP 自己處理分段與重傳,大訊息穩定得多。
-->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>

    <transport_descriptors>
      <transport_descriptor>
        <transport_id>tcp_client</transport_id>
        <type>TCPv4</type>
        <sendBufferSize>8388608</sendBufferSize>
        <receiveBufferSize>8388608</receiveBufferSize>
        <!-- Fast DDS 硬性上限 65500,寫更大會讓 transport 註冊失敗、participant 建不起來 -->
        <maxMessageSize>65500</maxMessageSize>
        <calculate_crc>false</calculate_crc>
        <check_crc>false</check_crc>
      </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="tcp_client_participant" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>tcp_client</transport_id>
        </userTransports>
        <!-- 保留內建 transport,WSL 內部的節點(rviz2、ros2 daemon)才互通 -->
        <useBuiltinTransports>true</useBuiltinTransports>

        <builtin>
          <initialPeersList>
            <locator>
              <tcpv4>
                <address>192.168.40.98</address>
                <physical_port>42100</physical_port>
                <port>42100</port>
              </tcpv4>
            </locator>
          </initialPeersList>
        </builtin>
      </rtps>
    </participant>

  </profiles>
</dds>
