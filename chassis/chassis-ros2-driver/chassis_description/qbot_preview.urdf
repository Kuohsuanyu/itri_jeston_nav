<?xml version="1.0" encoding="utf-8"?>
<!-- 自動產生,不要手改。改 urdf/qbot_sensors.xacro 之後重跑 gen_preview_urdf.py -->
<robot name="qbot">

  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.2032" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/DD-M/base_link.STL"/></geometry>
      <material name="white"><color rgba="0.85 0.86 0.88 1"/></material>
    </visual>
  </link>

  <link name="wheel_front_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/DD-M/wheel_front_left_link.STL"/></geometry>
      <material name="wheel_grey"><color rgba="0.50196 0.50196 0.50196 1"/></material>
    </visual>
  </link>
  <joint name="wheel_front_left_joint" type="continuous">
    <origin xyz="0.275 0.31105 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="wheel_front_left_link"/>
    <axis xyz="0 1 0"/>
  </joint>
  <link name="wheel_front_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/DD-M/wheel_front_right_link.STL"/></geometry>
      <material name="wheel_grey"><color rgba="0.50196 0.50196 0.50196 1"/></material>
    </visual>
  </link>
  <joint name="wheel_front_right_joint" type="continuous">
    <origin xyz="0.275 -0.31105 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="wheel_front_right_link"/>
    <axis xyz="0 -1 0"/>
  </joint>
  <link name="wheel_rear_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/DD-M/wheel_rear_left_link.STL"/></geometry>
      <material name="wheel_grey"><color rgba="0.50196 0.50196 0.50196 1"/></material>
    </visual>
  </link>
  <joint name="wheel_rear_left_joint" type="continuous">
    <origin xyz="-0.275 0.31105 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="wheel_rear_left_link"/>
    <axis xyz="0 1 0"/>
  </joint>
  <link name="wheel_rear_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/DD-M/wheel_rear_right_link.STL"/></geometry>
      <material name="wheel_grey"><color rgba="0.50196 0.50196 0.50196 1"/></material>
    </visual>
  </link>
  <joint name="wheel_rear_right_joint" type="continuous">
    <origin xyz="-0.275 -0.31105 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="wheel_rear_right_link"/>
    <axis xyz="0 -1 0"/>
  </joint>

  <link name="wiring_box">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.200 0.200 0.160"/></geometry>
      <material name="box_grey"><color rgba="0.25 0.27 0.30 1"/></material>
    </visual>
  </link>
  <joint name="wiring_box_joint" type="fixed">
    <parent link="base_link"/>
    <child link="wiring_box"/>
    <origin xyz="0 0 0.3310" rpy="0 0 0"/>
  </joint>

  <link name="body">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.033" length="0.062"/></geometry>
      <material name="lidar_black"><color rgba="0.15 0.15 0.17 1"/></material>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="body"/>
    <origin xyz="0.0250 0.0000 0.4515"
            rpy="0.0112 0.5181 0.0000"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.025 0.090 0.025"/></geometry>
      <material name="cam_blue"><color rgba="0.10 0.35 0.60 1"/></material>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.0892 -0.0454 0.3700"
            rpy="0.0092 -0.0278 0.0154"/>
  </joint>

</robot>
