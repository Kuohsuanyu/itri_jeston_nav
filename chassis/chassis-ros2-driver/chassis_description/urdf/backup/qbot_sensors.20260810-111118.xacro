<?xml version="1.0" encoding="utf-8"?>
<!--
  Q-BOT = ITRI DD-M 底盤 + Mid-360 光達 + D435F 相機

  底盤那一段完全沿用原廠的 chassis_DD-M.xacro,不改它 —— 這裡只 include 進來
  再掛上感測器。原廠更新時直接覆蓋 chassis_description 即可。

  === 原廠已經定義好的東西(不要重新發明)===
    base_footprint   地面,z=0,位於四輪中心的地面投影
    base_link        base_footprint 上方 0.2032 m(= 輪半徑,輪軸高度)
                     原點在四輪中心
    輪距 0.6221 m   軸距 0.55 m   輪半徑 0.2032 m(16 吋)

  === 這個檔案加的東西 ===
    body             FAST-LIO 的 body frame = Mid-360 的 IMU 座標系
    camera_link      D435F

  ★ 為什麼是 body 而不是 livox_frame:
    FAST-LIO 發的位姿和 /cloud_registered_body 的 frame_id 都是 body,
    而 body 是 Mid-360 的 **IMU** 座標系,不是光達光學中心、也不是安裝面。
    兩者之間的偏移寫在 mid360.yaml 的 extrinsic_T(Livox 手冊有標)。
    這裡直接定義 base_link -> body,把那一段一併吸收進來,
    所以下面的數值是「量出來的 body 實際位置」,不是機構圖上的安裝面位置。

  === 下面的數值怎麼來的 ===
    LIDAR_ROLL / LIDAR_PITCH   IMU 靜止重力方向(calib_base_link.py,精度約 0.2 度)
    LIDAR_Z                    地面平面擬合的高度,減去 base_link 的 0.2032
    LIDAR_X / LIDAR_Y          捲尺量(相對四輪中心)。這兩個對精度不敏感 ——
                               誤差只會平移地圖原點,不會扭曲任何東西;
                               只有原地旋轉的圓心會偏,2 公分等級可忽略。
    CAM_*                      calib_extrinsic.py 的 ICP 結果
-->
<robot name="qbot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 原廠底盤:base_footprint / base_link / 四個輪子 -->
  <xacro:include filename="$(find chassis_description)/urdf/chassis_DD-M.xacro" />

  <!-- ═══════════════════════════════════════════
       理線盒 —— 感測器支架的實際底座
       200 x 200 x 160 mm,鎖在上蓋正中心。

       PLATE_Z 是量自 base_link.STL 的上蓋平面高度:
         內凹平面  z = +0.2510   X ±0.4449   Y ±0.2150   離地 0.4542
         外框邊緣  z = +0.2530   X ±0.4500   Y ±0.3200   離地 0.4562
       兩層都精確對稱到 (0, 0),所以「鎖在正中心」= x=0, y=0,不用量。
       盒子 200 mm 遠小於內凹平面的 430 mm 短邊,放得下。

       盒頂(= 支架的安裝面)高度由這兩個值推出來,見檔案最後的註解。
  ══════════════════════════════════════════════ -->
  <xacro:property name="PLATE_Z" value="0.2510" />   <!-- 上蓋內凹平面,量自 STL -->
  <xacro:property name="BOX_L"   value="0.200"  />   <!-- 前後 -->
  <xacro:property name="BOX_W"   value="0.200"  />   <!-- 左右 -->
  <xacro:property name="BOX_H"   value="0.160"  />   <!-- 高 -->

  <link name="wiring_box">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><box size="${BOX_L} ${BOX_W} ${BOX_H}" /></geometry>
      <material name="box_grey"><color rgba="0.25 0.27 0.30 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><box size="${BOX_L} ${BOX_W} ${BOX_H}" /></geometry>
    </collision>
  </link>

  <!-- URDF 的 box 是以 link 原點為**中心**,不是底面。所以掛載高度要加半個盒高。 -->
  <joint name="wiring_box_joint" type="fixed">
    <parent link="base_link" />
    <child  link="wiring_box" />
    <origin xyz="0 0 ${PLATE_Z + BOX_H/2}" rpy="0 0 0" />
  </joint>

  <!-- 盒頂中心。支架都是從這一面往上長,所以給它一個座標系比較好對數字:
       量支架高度時量到的就是「相對 box_top 的 z」。 -->
  <link name="box_top" />
  <joint name="box_top_joint" type="fixed">
    <parent link="wiring_box" />
    <child  link="box_top" />
    <origin xyz="0 0 ${BOX_H/2}" rpy="0 0 0" />
  </joint>

  <!-- ═══════════════════════════════════════════
       感測器安裝參數  ★ 校準後改這裡
       全部相對 base_link(四輪中心、輪軸高度 0.2032 m)
       x 前為正   y 左為正   z 上為正

       為什麼不掛在 box_top 底下而是掛 base_link:
       校準工具(calib_extrinsic.py / calib_base_link.py)算出來的都是
       相對 base_link 的值,直接貼進來不用換算。box_top 只是給你
       量支架高度時對照用的參考面。
  ══════════════════════════════════════════════ -->

  <!-- Mid-360 的 IMU 座標系。PITCH 為正代表往下俯,機構圖標稱 30 度。
       ROLL / PITCH / Z 是 2026-08-10 用 calib_box.py 實測的(導航箱還沒上車,
       單獨正放在地板上量)。基準是**光達擬合出來的安裝面**,不是重力 ——
       要的是 body 相對盒底的姿態,地板歪不歪都不影響。

       量測當下三個獨立來源互相驗證:
         IMU 重力方向    上 = (-0.4997, -0.0058, +0.8662)
         地面平面擬合    法線 = (-0.4953, +0.0098, +0.8687)   兩者差 0.94 度
         相機 pitch      換到安裝面座標系後 -1.59 度(平視相機應為 0)
       15596 個地面內點,IMU 相對抖動 0.0031。

       Z 的來源:body 離盒底 0.2005 m,加上盒底貼的上蓋內凹平面 PLATE_Z 0.2510。
       不要靠 BOX_H 疊加 —— 0.2005 比盒高 0.160 多出來的 4.05 cm 就是支架,
       當初猜 5 cm,差 1.3 cm。

       X / Y   還是暫定值。箱子上車後捲尺量(相對四輪中心)。
               這兩個對精度不敏感:誤差只平移地圖原點,不扭曲任何東西。
       YAW     還沒量。要把箱子某一面貼平一面直牆,跑 calib_box.py --yaw,
               最近的那個垂直面就是牆,它的方位角給出箱子正面相對 body 的偏轉。
               目前的 0 等於假設「光達在箱子裡裝正」。 -->
  <xacro:property name="LIDAR_X"     value="0.0250"    />  <!-- ☐ 上車後捲尺量 -->
  <xacro:property name="LIDAR_Y"     value="-0.0000"    /> <!-- ☐ 上車後捲尺量 -->
  <xacro:property name="LIDAR_Z"     value="0.4515" />     <!-- = 0.2510 + 0.2005,實測 -->
  <xacro:property name="LIDAR_ROLL"  value="0.0112" />     <!-- 0.64 度,實測 -->
  <xacro:property name="LIDAR_PITCH" value="0.5181" />     <!-- 29.69 度,實測(標稱 30) -->
  <xacro:property name="LIDAR_YAW"   value="0.0000" />     <!-- ☐ 貼牆量 -->

  <!-- D435F。相機是平視的,所以在水平的 base_link 裡 pitch 應該接近 0 ——
       這正好是校準結果的自檢:若 ICP 算出來離 0 很遠,不是相機沒裝平,
       就是 LIDAR_PITCH 錯了。實測 -1.59 度,自檢通過。

       數值來源:2026-08-07 的 ICP 結果(body -> camera_link,殘差 12.9 -> 4.6 cm),
       由 calib_box.py 左乘安裝面的旋轉換算過來 —— 沒有重跑 ICP,是純數學換算。
       獨立驗證:把 /cloud_registered_body 投影到彩色影像跟對齊深度圖逐點比距離,
       851 組配對的中位差 +5.1 mm,87.7% 落在 5 cm 內,遠近與左右象限都一致。

       ★ X / Y 跟 LIDAR_X / LIDAR_Y 綁在一起 —— 相機和光達在同一個箱子裡,
         箱子在車上平移多少,兩個就一起平移多少:

             CAM_X = LIDAR_X + 0.0642        CAM_Y = LIDAR_Y - 0.0454

         這裡寫成算好的純數值而不是 ${LIDAR_X + 0.0642},是因為
         gen_preview_urdf.py 和 place_tool/server.py 都是 regex 抓字串再 float(),
         看不懂 xacro 運算式,寫成式子那兩個工具會當掉。
         **改 LIDAR_X / LIDAR_Y 的時候,CAM_X / CAM_Y 要照上面的式子一起改。**
         角度和 Z 是絕對值,不受箱子擺在車上哪裡影響,不用動。 -->
  <xacro:property name="CAM_X"     value="0.0892" />       <!-- = LIDAR_X + 0.0642 -->
  <xacro:property name="CAM_Y"     value="-0.0454" />      <!-- = LIDAR_Y - 0.0454 -->
  <xacro:property name="CAM_Z"     value="0.3700" />       <!-- 實測,在光達下方 8.2 cm -->
  <xacro:property name="CAM_ROLL"  value="0.0092" />       <!-- 0.52 度 -->
  <xacro:property name="CAM_PITCH" value="-0.0278" />      <!-- -1.59 度 -->
  <xacro:property name="CAM_YAW"   value="0.0154" />       <!-- 0.88 度 -->

  <!-- ═══════════════════════════════════════════
       Mid-360
  ══════════════════════════════════════════════ -->
  <link name="body">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><cylinder radius="0.033" length="0.062" /></geometry>
      <material name="lidar_black"><color rgba="0.15 0.15 0.17 1" /></material>
    </visual>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link" />
    <child  link="body" />
    <origin xyz="${LIDAR_X} ${LIDAR_Y} ${LIDAR_Z}"
            rpy="${LIDAR_ROLL} ${LIDAR_PITCH} ${LIDAR_YAW}" />
  </joint>

  <!-- ═══════════════════════════════════════════
       D435F
       camera_link 之下的 camera_*_optical_frame 由 realsense2_camera
       驅動自己發布,這裡不要重複定義 —— 重複會讓那些 frame 有兩個父節點,
       tf2 不會報錯,它會交替採用兩者,整棵樹以感測器頻率抖動。
  ══════════════════════════════════════════════ -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><box size="0.025 0.090 0.025" /></geometry>
      <material name="cam_blue"><color rgba="0.10 0.35 0.60 1" /></material>
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link" />
    <child  link="camera_link" />
    <origin xyz="${CAM_X} ${CAM_Y} ${CAM_Z}"
            rpy="${CAM_ROLL} ${CAM_PITCH} ${CAM_YAW}" />
  </joint>

</robot>
